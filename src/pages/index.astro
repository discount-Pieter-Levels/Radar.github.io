---
import Base from '../layouts/Base.astro';
import { SECTIONS, load, recent, SUGGEST_URL, type Section } from '../lib/data';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const sections = (Object.keys(SECTIONS) as Section[]).map((k) => ({ k, ...SECTIONS[k], n: load(k).length }));
const latest = recent(5);
---
<Base>
  <h1>Radar.</h1>
  <p class="lede">Grants, communities and fellowships<br />for builders in India.</p>

  <nav class="sections">
    {sections.map((s) => (
      <a href={`${base}/${s.k}/`}>
        <span class="t">{s.title}</span>
        <span class="b">{s.blurb}</span>
      </a>
    ))}
  </nav>

  <h2>New</h2>
  <ul class="latest">
    {latest.map((e) => (
      <li><a href={`${base}/${e.section}/#${e.id}`}>{e.name}<span class="mute"> — {SECTIONS[e.section].title}</span></a></li>
    ))}
  </ul>

  <footer>
    <a href={SUGGEST_URL}>Suggest an opportunity</a>
    <span>No government schemes. Ever.</span>
  </footer>
</Base>

<style>
  .sections { margin-top: 64px; border-top: 1px solid var(--line); }
  .sections a {
    display: grid; grid-template-columns: 1fr auto; padding: 28px 0;
    border-bottom: 1px solid var(--line); transition: opacity .2s;
  }
  .sections a:hover { opacity: .55; }
  .t { font-size: 28px; font-weight: 600; letter-spacing: -0.025em; }
  .b { grid-row: 2; color: var(--mute); }
  h2 { margin-top: 72px; font-size: 13px; font-weight: 600; text-transform: uppercase; letter-spacing: .08em; color: var(--mute); }
  .latest { list-style: none; margin-top: 16px; }
  .latest li { padding: 8px 0; }
  .latest a:hover { opacity: .55; }
</style>
