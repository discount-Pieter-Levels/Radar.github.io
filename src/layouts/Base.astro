---
const { title = 'Radar', description = 'Grants, communities and fellowships for builders in India.' } = Astro.props;
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---
<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="color-scheme" content="light dark" />
  <title>{title}</title>
  <meta name="description" content={description} />
  <link rel="icon" href={`${base}/favicon.svg`} type="image/svg+xml" />
  <slot name="head" />
  <style is:global>
    :root {
      --bg: #fff; --fg: #111; --mute: #8a8a8e; --line: #ececec; --soft: #f5f5f7;
      --font: -apple-system, BlinkMacSystemFont, "SF Pro Text", "Inter", "Helvetica Neue", system-ui, sans-serif;
    }
    @media (prefers-color-scheme: dark) {
      :root { --bg: #000; --fg: #f5f5f7; --mute: #86868b; --line: #1d1d1f; --soft: #161617; }
    }
    * { box-sizing: border-box; margin: 0; padding: 0; }
    html { -webkit-text-size-adjust: 100%; }
    body {
      background: var(--bg); color: var(--fg); font: 17px/1.47 var(--font);
      -webkit-font-smoothing: antialiased; letter-spacing: -0.01em;
    }
    a { color: inherit; text-decoration: none; }
    main { max-width: 680px; margin: 0 auto; padding: 72px 20px 120px; }
    h1 { font-size: clamp(40px, 8vw, 56px); font-weight: 700; letter-spacing: -0.035em; line-height: 1.05; }
    .lede { color: var(--mute); font-size: 21px; margin-top: 12px; letter-spacing: -0.015em; }
    .mute { color: var(--mute); }
    .back { display: inline-block; color: var(--mute); font-size: 15px; margin-bottom: 40px; transition: color .2s; }
    .back:hover { color: var(--fg); }
    footer { margin-top: 96px; font-size: 13px; color: var(--mute); display: flex; gap: 20px; }
    footer a:hover { color: var(--fg); }
    :focus-visible { outline: 2px solid var(--fg); outline-offset: 3px; border-radius: 4px; }
  </style>
</head>
<body>
  <main><slot /></main>
</body>
</html>
